---
import Icon from './Icon.astro';
import { url } from '../lib/helpers';
import type { ProjectView } from '../lib/projects';

interface Props {
  prev?: ProjectView;
  next?: ProjectView;
  allHref?: string;
}

const { prev, next, allHref = url('/projects/') } = Astro.props;
---

<nav class="project-nav" aria-label="Навигация по проектам">
  <div class="project-nav__grid">
    {
      prev ? (
        <a href={prev.href} class="project-nav__card project-nav__card--prev">
          <span class="project-nav__label mono">
            <Icon name="arrow-left" size={14} />
            Предыдущий проект
          </span>
          <span class="project-nav__title">{prev.data.title}</span>
          <span class="project-nav__meta mono">{prev.data.category.join(' / ')}</span>
        </a>
      ) : (
        <span class="project-nav__card project-nav__card--empty" aria-hidden="true" />
      )
    }

    {
      next ? (
        <a href={next.href} class="project-nav__card project-nav__card--next">
          <span class="project-nav__label mono">
            Следующий проект
            <Icon name="arrow-right" size={14} />
          </span>
          <span class="project-nav__title">{next.data.title}</span>
          <span class="project-nav__meta mono">{next.data.category.join(' / ')}</span>
        </a>
      ) : (
        <span class="project-nav__card project-nav__card--empty" aria-hidden="true" />
      )
    }
  </div>

  <a href={allHref} class="link-arrow project-nav__all">
    Все проекты
    <Icon name="arrow-up-right" size={14} />
  </a>
</nav>

<style>
  .project-nav {
    display: grid;
    gap: var(--space-5);
    margin-top: clamp(2.5rem, 5vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-line);
  }

  .project-nav__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .project-nav__card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(244, 243, 240, 0.028), transparent 60%), var(--color-surface);
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
    min-height: 132px;
  }

  .project-nav__card--next {
    align-items: flex-end;
    text-align: right;
  }

  .project-nav__card--empty {
    background: transparent;
    border-style: dashed;
    opacity: 0.35;
  }

  .project-nav__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.625rem;
  }

  .project-nav__title {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .project-nav__meta {
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  a.project-nav__card:hover {
    border-color: var(--color-line-accent);
    background-color: var(--color-surface-elevated);
    transform: translateY(-3px);
  }

  .project-nav__all {
    justify-self: start;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 620px) {
    .project-nav__grid {
      grid-template-columns: 1fr;
    }

    .project-nav__card--empty {
      display: none;
    }
  }
</style>
