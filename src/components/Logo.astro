---
import { site } from '../lib/helpers';

interface Props {
  compact?: boolean;
  gradientId?: string;
}

const { compact = false, gradientId = 'logo-grad' } = Astro.props;
---

<span class="logo" aria-hidden="true">
  <span class="logo__mark">
    <svg viewBox="0 0 44 44" width="44" height="44" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#B76CFA" />
          <stop offset="1" stop-color="#EC6FD2" />
        </linearGradient>
      </defs>
      <rect x="0.75" y="0.75" width="42.5" height="42.5" rx="13" fill="#14151A" stroke="rgba(244,243,240,0.14)" />
      <path d="M10 33V11h24v5.5H16.5v3.2H29V25H16.5v2.5H34V33H10Z" fill={`url(#${gradientId})`} />
      <path d="M30 11 39 20" stroke="#ACDDCC" stroke-width="1.4" stroke-linecap="round" opacity="0.75" />
    </svg>
  </span>
  {!compact && (
    <span class="logo__text">
      <span class="logo__name">{site.name}</span>
      <span class="logo__role">{site.role}</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .logo__mark {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    transition: transform 600ms var(--ease-out);
  }

  .logo__mark::after {
    content: '';
    position: absolute;
    inset: 6px;
    border-radius: 12px;
    background: radial-gradient(circle, rgba(183, 108, 250, 0.55), transparent 70%);
    filter: blur(12px);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
    z-index: -1;
  }

  .logo:hover .logo__mark::after {
    opacity: 1;
  }

  .logo:hover .logo__mark {
    transform: rotate(-4deg);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .logo__role {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .logo__role {
      display: none;
    }

    .logo__mark {
      width: 38px;
      height: 38px;
    }
  }
</style>
