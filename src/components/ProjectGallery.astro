---
import Icon from './Icon.astro';
import MediaImage from './MediaImage.astro';

interface Props {
  items: { src: string; alt: string; caption: string }[];
  title: string;
}

const { items, title } = Astro.props;
---

{
  items.length > 0 && (
    <div class="gallery" data-carousel="loop">
      <div class="gallery__head">
        <p class="mono gallery__count">
          {String(items.length).padStart(2, '0')} <span aria-hidden="true">/</span> изображений
        </p>
        {items.length > 1 && (
          <div class="gallery__buttons">
            <button type="button" class="icon-btn" data-carousel-prev aria-label="Предыдущее изображение">
              <Icon name="arrow-left" size={18} />
            </button>
            <button type="button" class="icon-btn" data-carousel-next aria-label="Следующее изображение">
              <Icon name="arrow-right" size={18} />
            </button>
          </div>
        )}
      </div>

      <div
        class="gallery__track"
        data-carousel-track
        role="region"
        aria-roledescription="карусель"
        aria-label={`Галерея проекта «${title}»`}
        tabindex={items.length > 1 ? 0 : -1}
      >
        {items.map((item, index) => (
          <figure class="gallery-item" data-carousel-slide>
            <div
              class="gallery-item__trigger"
              tabindex="0"
              data-lightbox

              data-alt={item.alt || title}
              data-caption={item.caption}
              aria-label={`Открыть изображение${item.caption ? `: ${item.caption}` : ` ${index + 1}`} в полном размере`}
            >
              <MediaImage
                src={item.src}
                alt={item.alt || `${title} — изображение ${index + 1}`}
                sizes="(max-width: 767px) 92vw, (max-width: 1200px) 70vw, 1100px"
                ratio="16 / 10"
                priority={index === 0}
              />
              <span class="gallery-item__zoom" aria-hidden="true">
                <Icon name="expand" size={16} />
              </span>
            </div>
            {item.caption && (
              <figcaption class="gallery-item__caption">
                <span class="mono">{String(index + 1).padStart(2, '0')}</span>
                {item.caption}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    gap: var(--space-4);
  }

  .gallery__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .gallery__count {
    color: var(--color-text-muted);
  }

  .gallery__buttons {
    display: flex;
    gap: 0.5rem;
  }

  .gallery__track {
    display: flex;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
    cursor: grab;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .gallery__track.is-dragging :global(button) {
    pointer-events: none;
  }

  .gallery-item {
    flex: 0 0 auto;
    width: clamp(260px, 78%, 1040px);
    scroll-snap-align: start;
    margin: 0;
  }

  .gallery-item:only-child {
    width: 100%;
  }

  .gallery-item__trigger {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    cursor: zoom-in;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .gallery-item__trigger :global(img) {
    transition: transform 900ms var(--ease-out);
  }

  .gallery-item__trigger:hover {
    border-color: var(--color-line-accent);
  }

  .gallery-item__trigger:hover :global(img) {
    transform: scale(1.015);
  }

  .gallery-item__zoom {
    position: absolute;
    right: 1rem;
    top: 1rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(244, 243, 240, 0.16);
    background: rgba(11, 12, 16, 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-text);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }

  .gallery-item__trigger:hover .gallery-item__zoom,
  .gallery-item__trigger:focus-visible .gallery-item__zoom {
    opacity: 1;
    transform: none;
  }

  .gallery-item__caption {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.85rem;
    font-size: var(--fs-sm);
    color: var(--color-text-secondary);
  }

  .gallery-item__caption :global(.mono) {
    color: var(--color-accent);
    font-size: 0.6875rem;
  }

  @media (max-width: 640px) {
    .gallery__buttons {
      display: none;
    }

    .gallery__track {
      scroll-padding-inline: 0;
    }

    .gallery-item {
      width: 92%;
    }

    .gallery-item__zoom {
      opacity: 1;
      transform: none;
    }
  }
</style>
