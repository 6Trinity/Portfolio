---
/**
 * Инлайн-иконки (без внешних библиотек).
 * Декоративные по умолчанию — aria-hidden. Если иконка несёт смысл,
 * передайте label: тогда она озвучивается скринридером.
 */
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'arrow-left'
    | 'arrow-down'
    | 'chevron-left'
    | 'chevron-right'
    | 'telegram'
    | 'mail'
    | 'github'
    | 'code'
    | 'search'
    | 'layers'
    | 'flow'
    | 'grid'
    | 'spark'
    | 'close'
    | 'expand'
    | 'menu'
    | 'up';
  size?: number;
  label?: string;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, label, class: className, strokeWidth = 1.6 } = Astro.props;
const a11y: Record<string, string> = label
  ? { role: 'img', 'aria-label': label }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  {...a11y}
>
  {name === 'arrow-right' && <><path d="M4 12h15" /><path d="m13 6 6 6-6 6" /></>}
  {name === 'arrow-left' && <><path d="M20 12H5" /><path d="m11 18-6-6 6-6" /></>}
  {name === 'arrow-up-right' && <><path d="M7 17 17 7" /><path d="M8 7h9v9" /></>}
  {name === 'arrow-down' && <><path d="M12 4v15" /><path d="m6 13 6 6 6-6" /></>}
  {name === 'chevron-left' && <path d="m15 5-7 7 7 7" />}
  {name === 'chevron-right' && <path d="m9 5 7 7-7 7" />}
  {name === 'close' && <><path d="m6 6 12 12" /><path d="M18 6 6 18" /></>}
  {name === 'expand' && <><path d="M4 9V4h5" /><path d="M20 15v5h-5" /><path d="M15 4h5v5" /><path d="M9 20H4v-5" /></>}
  {name === 'menu' && <><path d="M4 8h16" /><path d="M4 16h16" /></>}
  {name === 'up' && <><path d="M12 20V5" /><path d="m6 11 6-6 6 6" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="3" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'github' && (
    <path
      stroke="none"
      fill="currentColor"
      d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.36 1.09 2.93.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"
    />
  )}
  {name === 'telegram' && (
    <path
      stroke="none"
      fill="currentColor"
      d="M21.6 4.3 18.5 19c-.24 1.04-.85 1.3-1.72.81l-4.74-3.49-2.29 2.2c-.25.25-.47.47-.95.47l.34-4.84 8.8-7.95c.38-.34-.08-.53-.6-.19L6.46 12.6l-4.67-1.46c-1.02-.32-1.04-1.02.21-1.5l18.26-7.04c.85-.31 1.59.2 1.34 1.7Z"
    />
  )}
  {name === 'code' && <><path d="m8 7-5 5 5 5" /><path d="m16 7 5 5-5 5" /><path d="m13.5 4-3 16" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="m20 20-3.6-3.6" /><path d="M8.4 11h5.2" /></>}
  {name === 'layers' && <><path d="m12 3 8.5 4.7L12 12.4 3.5 7.7 12 3Z" /><path d="m4 12.6 8 4.5 8-4.5" /><path d="m4 17.2 8 4.5 8-4.5" /></>}
  {name === 'flow' && <><path d="M4 6c4 0 4 12 8 12s4-12 8-12" /><circle cx="4" cy="6" r="1.6" /><circle cx="20" cy="18" r="1.6" /></>}
  {name === 'grid' && <><rect x="4" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5" /><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5" /><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5" /></>}
  {name === 'spark' && <><path d="M12 3v4" /><path d="M12 17v4" /><path d="M3 12h4" /><path d="M17 12h4" /><path d="m6.3 6.3 2.5 2.5" /><path d="m15.2 15.2 2.5 2.5" /><path d="m17.7 6.3-2.5 2.5" /><path d="m8.8 15.2-2.5 2.5" /></>}
</svg>
