---
import { about, home } from '../../lib/helpers';

const { about: heading } = home;
const paragraphs = heading.text
  .split(/\n\s*\n/)
  .map((part) => part.trim())
  .filter(Boolean);

const experience = about.experience.filter((item) => item.company?.trim());
const skills = about.skills.filter((group) => group.items.length > 0);
---

<section class="about section" id="about" aria-labelledby="about-title">
  <div class="container about__grid">
    <div class="about__left" data-reveal>
      <div class="section-head section-head--flat">
        <div class="section-head__top">
          <span class="section-head__index mono">04</span>
          <span class="section-head__label">{heading.eyebrow}</span>
        </div>
        <h2 class="section-head__title about__title" id="about-title">
          {heading.title}
        </h2>
      </div>

      <div class="about__text">
        {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {heading.education && (
        <p class="about__education mono">
          <span class="about__education-dot" aria-hidden="true"></span>
          {heading.education}
        </p>
      )}
    </div>

    <div class="about__right" data-reveal style="--reveal-delay: 120ms">
      {
        experience.length > 0 && (
          <div class="about__block">
            <h3 class="about__block-title mono">Профессиональный опыт</h3>
            <ol class="experience">
              {experience.map((item) => (
                <li class="experience__item">
                  <div class="experience__head">
                    <span class="experience__company">{item.company}</span>
                    {item.period && <span class="experience__period mono">{item.period}</span>}
                  </div>
                  {item.position && <p class="experience__role">{item.position}</p>}
                  {item.description && <p class="experience__desc">{item.description}</p>}
                </li>
              ))}
            </ol>
          </div>
        )
      }

      {
        skills.length > 0 && (
          <div class="about__block">
            <h3 class="about__block-title mono">Технологии и инструменты</h3>
            <dl class="skills">
              {skills.map((group) => (
                <div class="skills__group">
                  <dt>{group.group}</dt>
                  <dd>
                    <ul class="tag-list">
                      {group.items.map((item) => (
                        <li class="tag">{item}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .section-head--flat {
    margin-bottom: clamp(1.25rem, 2vw, 2rem);
  }

  .about__title {
    max-width: 16ch;
    margin-top: var(--space-4);
  }

  .about__text {
    display: grid;
    gap: var(--space-4);
    max-width: 40rem;
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    line-height: 1.62;
  }

  .about__text p:first-child {
    color: var(--color-text);
  }

  .about__education {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-6);
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: none;
    color: var(--color-text-secondary);
  }

  .about__education-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mint);
  }

  .about__right {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .about__block {
    padding: clamp(1.35rem, 2.2vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(244, 243, 240, 0.03), rgba(244, 243, 240, 0) 60%), var(--color-surface);
  }

  .about__block-title {
    margin-bottom: var(--space-4);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
  }

  .experience {
    display: grid;
    gap: var(--space-4);
  }

  .experience__item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .experience__item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .experience__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .experience__company {
    font-family: var(--font-display);
    font-size: var(--fs-base);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .experience__period {
    font-size: 0.625rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .experience__role {
    margin-top: 0.15rem;
    font-size: var(--fs-sm);
    color: var(--color-accent);
  }

  .experience__desc {
    margin-top: 0.4rem;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  .skills {
    display: grid;
    gap: var(--space-5);
  }

  .skills__group {
    display: grid;
    gap: 0.6rem;
  }

  .skills__group dt {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .skills__group dd {
    margin: 0;
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__title {
      max-width: 20ch;
    }
  }
</style>
