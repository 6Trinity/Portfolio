---
import Icon from '../Icon.astro';
import { home, url } from '../../lib/helpers';

const { hero } = home;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid container">
    <div class="hero__content">
      <p class="hero__eyebrow" data-reveal style="--reveal-delay: 40ms">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>

      <h1 class="hero__title" id="hero-title" data-reveal style="--reveal-delay: 120ms">
        {hero.title}
      </h1>

      <p class="hero__subtitle" data-reveal style="--reveal-delay: 220ms">
        {hero.subtitle}
      </p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 300ms">
        <a href={url(hero.primaryCtaHref)} class="btn btn--ghost">
          {hero.primaryCtaLabel}
          <Icon name="arrow-down" size={17} />
        </a>
        <a href={url(hero.secondaryCtaHref)} class="btn btn--accent">
          {hero.secondaryCtaLabel}
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>

      <p class="hero__footnote" data-reveal style="--reveal-delay: 380ms">
        <span class="hero__footnote-line" aria-hidden="true"></span>
        {hero.footnote}
      </p>
    </div>

    <div class="hero__visual" data-hero-object aria-hidden="true">
      <div class="hero__visual-frame">
        <canvas width="900" height="900"></canvas>
        <div class="hero__visual-ring"></div>
        <div class="hero__visual-badge mono">
          <span class="hero__visual-badge-dot"></span>
          Digital Flow
        </div>
        <div class="hero__visual-coords mono">
          <span>55.75 N</span>
          <span>37.61 E</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /* Первый экран целиком помещается в окно без прокрутки. */
    min-height: 100svh;
    padding-block: calc(var(--header-h) + clamp(1.25rem, 3.5vh, 2.5rem)) clamp(1.5rem, 3.5vh, 2.5rem);
    overflow: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 46rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    padding: 0.5rem 0.95rem 0.5rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: rgba(244, 243, 240, 0.03);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .hero__eyebrow-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-mint);
    box-shadow: 0 0 0 4px rgba(172, 221, 204, 0.12);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow-dot::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 1px solid rgba(172, 221, 204, 0.5);
      animation: hero-pulse 3.2s var(--ease-out) infinite;
    }
  }

  @keyframes hero-pulse {
    0% {
      transform: scale(0.8);
      opacity: 0.9;
    }
    70%,
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }

  .hero__title {
    margin-bottom: clamp(1rem, 1.8vw, 1.5rem);
  }

  .hero__title :global(em) {
    font-style: normal;
    background: var(--gradient-flow);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__subtitle {
    max-width: 34rem;
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }

  .hero__footnote {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .hero__footnote-line {
    width: 40px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  /* ── Графический объект ── */
  .hero__visual {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    /* Не выше доступной высоты экрана — иначе первый экран уходит в скролл. */
    max-width: min(620px, calc(100svh - var(--header-h) - 6rem));
    justify-self: end;
    transform: translate3d(calc(var(--px, 0) * 10px), calc((var(--py, 0) * 10px) - var(--scroll, 0) * 40px), 0);
    transition: transform 900ms var(--ease-out);
  }

  .hero__visual-frame {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
  }

  .hero__visual-frame::before {
    content: '';
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    border: 1px dashed rgba(244, 243, 240, 0.07);
  }

  .hero__visual-frame::after {
    content: '';
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    border: 1px solid rgba(183, 108, 250, 0.12);
  }

  canvas {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    filter: saturate(1.05) blur(0.1px);
  }

  .hero__visual-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, transparent 62%, rgba(183, 108, 250, 0.06) 78%, transparent 90%);
    pointer-events: none;
  }

  .hero__visual-badge {
    position: absolute;
    left: 6%;
    bottom: 16%;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: rgba(16, 17, 22, 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-text);
    letter-spacing: 0.1em;
  }

  .hero__visual-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent);
  }

  .hero__visual-coords {
    position: absolute;
    top: 12%;
    right: 2%;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    color: var(--color-text-muted);
    text-align: right;
  }

  /* ── Адаптив ── */
  @media (max-width: 1100px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr);
    }
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 100svh;
      padding-top: calc(var(--header-h) + 1.5rem);
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: clamp(2rem, 6vw, 3rem);
    }

    .hero__content {
      max-width: 100%;
    }

    /* На узком экране объект не должен выталкивать кнопки за пределы окна. */
    .hero__visual {
      justify-self: center;
      width: min(78%, 380px, 34svh);
      max-width: none;
    }

    .hero__visual-coords {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-top: calc(var(--header-h) + 1.25rem);
    }

    .hero__grid {
      gap: 1.5rem;
    }

    .hero__eyebrow {
      margin-bottom: 1rem;
      font-size: 0.625rem;
      letter-spacing: 0.1em;
    }

    .hero__visual {
      width: min(58%, 240px, 26svh);
    }

    .hero__footnote {
      margin-top: 1.5rem;
      flex-wrap: wrap;
      row-gap: 0.4rem;
      font-size: 0.625rem;
      letter-spacing: 0.06em;
    }

    .hero__footnote-line {
      width: 100%;
      flex-basis: 100%;
    }

    .hero__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .hero__actions :global(.btn) {
      width: 100%;
    }

    .hero__visual-badge {
      left: 0;
      bottom: -4%;
    }
  }
</style>
