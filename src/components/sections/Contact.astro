---
import Icon from '../Icon.astro';
import { home, site } from '../../lib/helpers';

const { contact } = home;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Обсуждение проекта')}`;
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact__wrap">
      <div class="contact__panel" data-reveal>
        <div class="contact__glow" aria-hidden="true"></div>

        <div class="contact__body">
        <div class="section-head__top">
          <span class="section-head__index mono">05</span>
          <span class="section-head__label">{contact.eyebrow}</span>
        </div>

        <h2 class="contact__title" id="contact-title">{contact.title}</h2>
        <p class="contact__subtitle">{contact.subtitle}</p>

        <div class="contact__actions">
          <a href={site.telegram} class="btn btn--accent" target="_blank" rel="noopener noreferrer">
            <Icon name="telegram" size={17} />
            {contact.primaryCtaLabel}
          </a>
          <a href={mailto} class="btn btn--ghost">
            <Icon name="mail" size={17} />
            {contact.secondaryCtaLabel}
          </a>
        </div>

        {contact.responseNote && (
          <p class="contact__note">
            <span class="contact__note-dot" aria-hidden="true"></span>
            {contact.responseNote}
          </p>
        )}
        </div>

        <ul class="contact__links">
        <li>
          <a href={site.telegram} class="contact-link" target="_blank" rel="noopener noreferrer">
            <span class="contact-link__icon" aria-hidden="true"><Icon name="telegram" size={16} /></span>
            <span class="contact-link__body">
              <span class="contact-link__label mono">Telegram</span>
              <span class="contact-link__value">{site.telegramHandle}</span>
            </span>
            <Icon name="arrow-up-right" size={16} class="contact-link__arrow" />
          </a>
        </li>
        <li>
          <a href={mailto} class="contact-link">
            <span class="contact-link__icon" aria-hidden="true"><Icon name="mail" size={16} /></span>
            <span class="contact-link__body">
              <span class="contact-link__label mono">Email</span>
              <span class="contact-link__value">{site.email}</span>
            </span>
            <Icon name="arrow-up-right" size={16} class="contact-link__arrow" />
          </a>
        </li>
        <li>
          <a href={site.github} class="contact-link" target="_blank" rel="noopener noreferrer">
            <span class="contact-link__icon" aria-hidden="true"><Icon name="github" size={16} /></span>
            <span class="contact-link__body">
              <span class="contact-link__label mono">GitHub</span>
              <span class="contact-link__value">{site.githubHandle}</span>
            </span>
            <Icon name="arrow-up-right" size={16} class="contact-link__arrow" />
          </a>
        </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .contact__panel {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding: clamp(1.75rem, 4vw, 4.25rem);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(70% 90% at 0% 0%, rgba(183, 108, 250, 0.16), transparent 60%),
      radial-gradient(50% 70% at 100% 100%, rgba(172, 221, 204, 0.07), transparent 60%),
      var(--color-surface);
    overflow: hidden;
    isolation: isolate;
  }

  .contact__glow {
    position: absolute;
    right: -12%;
    top: -30%;
    width: 55%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid rgba(183, 108, 250, 0.16);
    box-shadow:
      0 0 0 60px rgba(183, 108, 250, 0.035),
      0 0 0 140px rgba(183, 108, 250, 0.02);
    pointer-events: none;
    z-index: -1;
  }

  .contact__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .contact__title {
    margin-top: var(--space-5);
    max-width: 18ch;
    font-size: var(--fs-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .contact__subtitle {
    margin-top: var(--space-4);
    max-width: 40ch;
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    line-height: 1.55;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .contact__note {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .contact__note-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-mint);
    box-shadow: 0 0 10px rgba(172, 221, 204, 0.7);
  }

  .contact__links {
    display: grid;
    gap: 0.6rem;
    align-content: center;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: rgba(11, 12, 16, 0.35);
    transition:
      border-color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .contact-link__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .contact-link__body {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }

  .contact-link__label {
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  .contact-link__value {
    font-size: var(--fs-sm);
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact-link__arrow {
    flex: none;
    color: var(--color-text-muted);
    transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
  }

  .contact-link:hover {
    border-color: var(--color-line-accent);
    background: rgba(183, 108, 250, 0.06);
    transform: translateY(-2px);
  }

  .contact-link:hover .contact-link__arrow {
    transform: translate(2px, -2px);
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .contact__panel {
      grid-template-columns: 1fr;
    }

    .contact__glow {
      right: -30%;
      top: -20%;
      width: 80%;
    }
  }

  @media (max-width: 560px) {
    .contact__actions {
      display: grid;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .contact__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
