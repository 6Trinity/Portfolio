---
import { absoluteUrl, site } from '../lib/helpers';

interface Props {
  title: string;
  description: string;
  /** Абсолютный canonical. */
  canonical: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** JSON-LD как готовая строка (из lib/seo.ts). */
  jsonLd?: string;
  /** true — заголовок уже включает имя; false — добавится после. */
  rawTitle?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = site.ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
  rawTitle = false,
} = Astro.props;

const fullTitle = rawTitle ? title : `${title} — ${site.name}`;
const image = absoluteUrl(ogImage);
const imageAlt = `${site.name} — ${site.role}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32" />
<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
