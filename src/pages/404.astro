---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { absoluteUrl } from '../lib/helpers';
---

<BaseLayout
  title="Страница не найдена"
  description="Страница не найдена — возможно, адрес изменился или проект ещё не опубликован."
  canonical={absoluteUrl('/404.html')}
  noindex
  page="notfound"
>
  <section class="notfound">
    <div class="container notfound__inner">
      <div class="notfound__visual" aria-hidden="true">
        <span class="notfound__code mono">404</span>
        <span class="notfound__orbit"></span>
        <span class="notfound__orbit notfound__orbit--inner"></span>
      </div>

      <div class="notfound__content">
        <p class="mono notfound__eyebrow">Route not found</p>
        <h1 class="notfound__title">Такой страницы нет</h1>
        <p class="notfound__text">
          Возможно, адрес изменился, проект ещё не опубликован или в ссылке опечатка. Вернитесь на главную или
          откройте список работ.
        </p>
        <div class="notfound__actions">
          <a href="/" class="btn btn--primary">
            На главную
            <Icon name="arrow-right" size={16} />
          </a>
          <a href="/projects/" class="btn btn--ghost">
            Все проекты
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding-block: calc(var(--header-h) + 3rem) var(--space-8);
  }

  .notfound__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .notfound__visual {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    width: 100%;
    max-width: 440px;
  }

  .notfound__code {
    position: relative;
    z-index: 1;
    font-size: clamp(4rem, 2rem + 9vw, 8rem);
    letter-spacing: 0.06em;
    color: var(--color-text);
    background: var(--gradient-flow);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .notfound__orbit {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    border: 1px dashed rgba(183, 108, 250, 0.35);
  }

  .notfound__orbit--inner {
    inset: 22%;
    border-style: solid;
    border-color: rgba(172, 221, 204, 0.18);
  }

  .notfound__visual::after {
    content: '';
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(183, 108, 250, 0.22), transparent);
    filter: blur(20px);
  }

  .notfound__eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  .notfound__title {
    font-size: var(--fs-3xl);
    letter-spacing: var(--tracking-tight);
  }

  .notfound__text {
    margin-top: var(--space-4);
    max-width: 44ch;
    color: var(--color-text-secondary);
    font-size: var(--fs-md);
    line-height: 1.6;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-6);
  }

  @media (max-width: 820px) {
    .notfound__inner {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .notfound__visual {
      max-width: 300px;
      justify-self: center;
    }
  }

  @media (max-width: 480px) {
    .notfound__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
